{
    "name": "fueled/idempotent-export",
    "description": "WP-CLI command that exports a WordPress site as a deterministic tree of JSON files.",
    "type": "wp-cli-package",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "IdempotentExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdempotentExport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:feature": "pest --testsuite=Feature"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
